#!/usr/bin/env bash
# Playwright CLI dla workera przeglądarkowego (od 2026-10-12 zamiast Playwright MCP) — CLI-WORKER.md.
# Uruchamia playwright-cli z playwright zainstalowanego w browser-check, bez żadnej instalacji.
# WSL (Spark): woła node.exe Windows wprost — argumenty omijają cmd.exe, więc cudzysłowy
# i polskie znaki przechodzą nietknięte. Git Bash: node z PATH.
# Artefakty (.playwright-cli/) lądują w bieżącym katalogu — uruchamiaj z katalogu roboczego briefu.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
win_node='/mnt/c/Program Files/nodejs/node.exe'
if [ -x "$win_node" ] && command -v wslpath > /dev/null 2>&1; then
  exec "$win_node" "$(wslpath -w "$here/node_modules/playwright/cli.js")" cli "$@"
fi
exec node "$here/node_modules/playwright/cli.js" cli "$@"
